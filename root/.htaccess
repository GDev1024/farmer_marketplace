RewriteEngine On

# Redirect all requests to index.php if the file doesn't exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/farmer_marketplace/root/index\.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Handle specific page routes
RewriteRule ^browse/?$ index.php?page=browse [QSA,L]
RewriteRule ^login/?$ index.php?page=login [QSA,L]
RewriteRule ^register/?$ index.php?page=register [QSA,L]
RewriteRule ^cart/?$ index.php?page=cart [QSA,L]
RewriteRule ^sell/?$ index.php?page=sell [QSA,L]
RewriteRule ^profile/?$ index.php?page=profile [QSA,L]
RewriteRule ^orders/?$ index.php?page=orders [QSA,L]
RewriteRule ^messages/?$ index.php?page=messages [QSA,L]
RewriteRule ^checkout/?$ index.php?page=checkout [QSA,L]